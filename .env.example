# Copy this file to .env and fill in your real values. Never commit .env itself.

# MongoDB Atlas connection string (from Atlas dashboard -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/distrochat?retryWrites=true&w=majority

# Port the server listens on locally. Render sets this automatically in production.
PORT=5000

# ── Admin panel ──
# The password you'll type at the admin login screen. Keep this strong and secret —
# do not reuse a password from anywhere else.
ADMIN_PASSWORD=change-this-to-something-only-you-know

# Used to sign admin login sessions. Any long random string works — you can generate
# one at https://randomkeygen.com (use a "CodeIgniter Encryption Key" or similar).
SESSION_SECRET=change-this-to-a-long-random-string

# The URL path for the admin panel, e.g. https://yourapp.onrender.com/ADMIN_PATH
# Change this to something not obvious so casual visitors can't stumble onto the login page.
# It's not your only protection (the password still gates access) but it helps.
ADMIN_PATH=/admin-panel
